# demo — отдельный локальный трекер; live — настоящий Keitaro Admin API.
APP_MODE=demo
DATABASE_URL=sqlite:///./data/adrobot.db
DEMO_DATABASE_URL=sqlite:///./data/keitaro-demo.db

# Укажите адрес трекера без /admin, либо полный путь /admin_api/v1.
KEITARO_URL=
KEITARO_API_KEY=
KEITARO_TIMEOUT=15

# Необязательно: значения для формы создания кампании.
# Если не заданы, используется первый доступный элемент соответствующего списка.
DEFAULT_DOMAIN_ID=
DEFAULT_GROUP_ID=
DEFAULT_SOURCE_ID=

# Необязательно для локального запуска. Перед открытием внешнего доступа задайте пароль.
APP_USERNAME=adrobot
APP_PASSWORD=
